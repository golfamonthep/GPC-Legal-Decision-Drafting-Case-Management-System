# Database connection strings (never commit real secrets)
# DATABASE_URL: Supabase transaction pooler (usually port 6543, pgbouncer=true)
DATABASE_URL=
# DIRECT_URL: direct/session connection used only for migrations
DIRECT_URL=

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Microsoft Graph / OneDrive / SharePoint integration
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_SHAREPOINT_SITE_ID=
MICROSOFT_SHAREPOINT_DRIVE_ID=
MICROSOFT_CASE_ROOT_FOLDER_ID=

# NextAuth v4 / Microsoft Entra ID authentication
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
MICROSOFT_ENTRA_ID_ALLOWED_DOMAIN=
AUTH_ALLOW_FIRST_ADMIN_BOOTSTRAP=false

# Use separate Entra credentials for login when possible
MICROSOFT_ENTRA_ID_TENANT_ID=
MICROSOFT_ENTRA_ID_CLIENT_ID=
MICROSOFT_ENTRA_ID_CLIENT_SECRET=

# Authentication mode
# microsoft = Microsoft Entra ID login (recommended for production)
# simple    = signed internal access-code session (acceptable for controlled pilot)
# none      = no login; blocked in production unless ALLOW_INSECURE_AUTH_MODE=true
AUTH_MODE=simple

# Required for AUTH_MODE=simple
MVP_ACCESS_CODE=
MVP_SESSION_SECRET=
# Allowed: ADMIN, COMMISSIONER, LEGAL_OFFICER, REGISTRY_OFFICER, VIEWER
MVP_DEFAULT_ROLE=REGISTRY_OFFICER

# Dangerous escape hatch for temporary incident recovery only.
# Never enable on a public production deployment.
ALLOW_INSECURE_AUTH_MODE=false

# Public database health endpoint returns generic information in production.
# Enable detailed host/diagnostic output only for a short troubleshooting window.
HEALTH_EXPOSE_DETAILS=false
