DATABASE_URL=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Microsoft Graph / OneDrive / SharePoint Integration
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_SHAREPOINT_SITE_ID=
MICROSOFT_SHAREPOINT_DRIVE_ID=
MICROSOFT_CASE_ROOT_FOLDER_ID=

# Authentication (NextAuth / Auth.js)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_ALLOW_FIRST_ADMIN_BOOTSTRAP=true
MICROSOFT_ENTRA_ID_ALLOWED_DOMAIN=

# If using separate credentials for Entra ID login vs Graph operations (recommended, otherwise reuse above)
MICROSOFT_ENTRA_ID_TENANT_ID=
MICROSOFT_ENTRA_ID_CLIENT_ID=
MICROSOFT_ENTRA_ID_CLIENT_SECRET=

# MVP Simple Internal Access Mode
# Use AUTH_MODE=simple for controlled MVP internal access.
# Do not use AUTH_MODE=disabled in production.
# Store real access code only in Vercel environment variables.
AUTH_MODE=microsoft
MVP_ACCESS_CODE=
MVP_DEFAULT_ROLE=operator
