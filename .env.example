# Database connection strings (Do NOT commit actual secrets)
# DATABASE_URL should point to the Transaction Pooler (port 6543) with ?pgbouncer=true
DATABASE_URL=
# DIRECT_URL should point to the Session connection (port 5432) for migrations
DIRECT_URL=

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Microsoft Graph / OneDrive / SharePoint Integration
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_SHAREPOINT_SITE_ID=
MICROSOFT_SHAREPOINT_DRIVE_ID=
MICROSOFT_CASE_ROOT_FOLDER_ID=

# Authentication (NextAuth / Auth.js)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_ALLOW_FIRST_ADMIN_BOOTSTRAP=true
MICROSOFT_ENTRA_ID_ALLOWED_DOMAIN=

# If using separate credentials for Entra ID login vs Graph operations (recommended, otherwise reuse above)
MICROSOFT_ENTRA_ID_TENANT_ID=
MICROSOFT_ENTRA_ID_CLIENT_ID=
MICROSOFT_ENTRA_ID_CLIENT_SECRET=

# MVP Simple Internal Access Mode
# AUTH_MODE options:
# none = no login required, for immediate MVP testing only
# simple = controlled MVP internal access via access code
# microsoft = Microsoft login, for controlled/production use later
# Store real access code only in Vercel environment variables.
AUTH_MODE=none
MVP_ACCESS_CODE=
MVP_DEFAULT_ROLE=operator
