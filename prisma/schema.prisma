// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String // e.g. "admin", "commissioner", "legal_officer"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  casesOwned    Case[]       @relation("OwnerCommissioner")
  casesAssigned Case[]       @relation("LegalOfficer")
  auditLogs     AuditLog[]
  aiQueries     AiQueryLog[]
  retrievalQueries RetrievalQuery[]
}

model Case {
  id             String  @id @default(uuid())
  type           String // "ร้องทุกข์" | "อุทธรณ์"
  blackNumber    String  @unique
  redNumber      String? @unique
  petitionerName String
  respondentName String
  subject        String
  legalCategory  String

  ownerId String?
  owner   User?   @relation("OwnerCommissioner", fields: [ownerId], references: [id])

  legalOfficerId String?
  legalOfficer   User?   @relation("LegalOfficer", fields: [legalOfficerId], references: [id])

  receivedDate DateTime
  dueDate30    DateTime?
  dueDate60    DateTime?
  dueDate90    DateTime?
  dueDate120   DateTime?
  dueDate240   DateTime?

  currentStatus  String
  meetingDate    DateTime?
  decisionResult String?
  oneDriveUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents CaseDocument[]
  events    CaseEvent[]
  drafts    DecisionDraft[]
}

model CaseDocument {
  id         String   @id @default(uuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  type       String // e.g. "complaint", "evidence", "rebuttal"
  uploadedAt DateTime @default(now())

  documentChunks DocumentChunk[]
}

model CaseEvent {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action    String
  actorName String
  timestamp DateTime @default(now())
}

model DecisionDraft {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title     String
  status    String // "draft", "review", "approved"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections DecisionDraftSection[]
}

model DecisionDraftSection {
  id          String        @id @default(uuid())
  draftId     String
  draft       DecisionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  sectionType String // "facts", "issues", "reasoning", "conclusion"
  content     String        @db.Text
  order       Int
  status      String // "pending", "in_progress", "completed"
  updatedAt   DateTime      @updatedAt
}

model LegalSource {
  id              String    @id @default(uuid())
  title           String
  documentType    String // "SupremeAdministrativeCourt", "GPC_Decision", "Act"
  referenceNumber String?
  date            DateTime?
  url             String?

  year            Int?
  caseType        String?
  legalCategory   String?
  issueTags       String[]
  lawNames        String[]
  sectionNumbers  String[]
  decisionResult  String?
  sourceStatus    String   @default("ใช้งาน")
  reliabilityLevel String  @default("official")
  effectiveDate   DateTime?
  expiredDate     DateTime?
  sourceFileUrl   String?

  clauses LegalClause[]
  ingestionJobs DocumentIngestionJob[]
  documentChunks DocumentChunk[]
}

model LegalClause {
  id           String      @id @default(uuid())
  sourceId     String
  source       LegalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  clauseNumber String
  content      String      @db.Text
}

model AiQueryLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  prompt     String   @db.Text
  response   String   @db.Text
  tokensUsed Int?
  modelUsed  String?
  timestamp  DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  beforeValue String?  @db.Text
  afterValue  String?  @db.Text
  timestamp   DateTime @default(now())
}

model DocumentIngestionJob {
  id            String   @id @default(uuid())
  legalSourceId String?
  legalSource   LegalSource? @relation(fields: [legalSourceId], references: [id], onDelete: Cascade)
  status        String   // "pending", "processing", "completed", "failed"
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DocumentChunk {
  id                String   @id @default(uuid())
  legalSourceId     String
  legalSource       LegalSource @relation(fields: [legalSourceId], references: [id], onDelete: Cascade)
  caseDocumentId    String?
  caseDocument      CaseDocument? @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)
  
  chunkIndex        Int
  title             String?
  content           String   @db.Text
  normalizedContent String   @db.Text
  
  pageNumber        Int?
  sectionName       String?
  paragraphNumber   Int?
  
  sourceType        String
  sourceStatus      String
  reliabilityLevel  String
  legalCategory     String?
  
  issueTags         String[]
  lawNames          String[]
  articleNumbers    String[]
  decisionResult    String?
  
  effectiveDate     DateTime?
  expiredDate       DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // embedding vector(1536) if using text-embedding-3-small
  // text-embedding-3-large would require vector(3072)
  embedding         Unsupported("vector(1536)")?

  citations         DocumentChunkCitation[]
  retrievalResults  RetrievalResult[]
  legalAnswerCitations LegalAnswerCitation[]

  @@index([legalSourceId])
  @@index([sourceStatus])
  @@index([reliabilityLevel])
  @@index([legalCategory])
  @@index([issueTags])
  @@index([effectiveDate, expiredDate])
}

model DocumentChunkCitation {
  id              String   @id @default(uuid())
  chunkId         String
  chunk           DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model RetrievalQuery {
  id            String   @id @default(uuid())
  queryText     String   @db.Text
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  results       RetrievalResult[]
  answers       LegalAnswer[]
}

model RetrievalResult {
  id            String   @id @default(uuid())
  queryId       String
  query         RetrievalQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  chunkId       String
  chunk         DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  score         Float?
  rank          Int?
  createdAt     DateTime @default(now())
}

model LegalAnswer {
  id            String   @id @default(uuid())
  queryId       String
  query         RetrievalQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  answerText    String   @db.Text
  createdAt     DateTime @default(now())

  citations     LegalAnswerCitation[]
}

model LegalAnswerCitation {
  id            String   @id @default(uuid())
  answerId      String
  answer        LegalAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  chunkId       String
  chunk         DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

