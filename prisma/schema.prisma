// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  output     = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String
  role               String // e.g. "ADMIN", "COMMISSIONER", "LEGAL_OFFICER", "REGISTRY_OFFICER", "VIEWER"
  microsoftAccountId String?   @unique
  image              String?
  status             String    @default("PENDING") // "PENDING", "ACTIVE", "DISABLED"
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  casesOwned         Case[]              @relation("OwnerCommissioner")
  casesAssigned      Case[]              @relation("LegalOfficer")
  auditLogs          AuditLog[]
  aiQueries          AiQueryLog[]
  retrievalQueries   RetrievalQuery[]
  draftSectionAiLogs DraftSectionAiLog[]
  meetingsCreated    Meeting[]           @relation("MeetingCreator")
  meetingsFollowUps  MeetingAgendaItem[] @relation("FollowUpUser")
  archiveBatchesCreated ArchiveBatch[]   @relation("ArchiveBatchCreator")
}

model Case {
  id             String  @id @default(uuid())
  type           String // "ร้องทุกข์" | "อุทธรณ์"
  blackNumber    String  @unique
  redNumber      String? @unique
  petitionerName String
  respondentName String
  subject        String
  legalCategory  String

  ownerId String?
  owner   User?   @relation("OwnerCommissioner", fields: [ownerId], references: [id])

  legalOfficerId   String?
  legalOfficer     User?   @relation("LegalOfficer", fields: [legalOfficerId], references: [id])
  legalOfficerName String?

  committeeOwnerName  String?
  assignedAt          DateTime?
  assignmentUpdatedAt DateTime?

  receivedDate DateTime?
  dueDate30    DateTime?
  dueDate60    DateTime?
  dueDate90    DateTime?
  dueDate120   DateTime?
  dueDate240   DateTime?

  currentStatus  String
  meetingDate    DateTime?
  decisionResult String?
  oneDriveUrl    String?
  proceedingNote String?   @db.Text
  dispatchData   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents            CaseDocument[]
  events               CaseEvent[]
  drafts               DecisionDraft[]
  agendaItems          MeetingAgendaItem[]
  archiveRecords       CaseArchiveRecord[]
  knowledgeReuseReviews KnowledgeReuseReview[]
  archiveBatchItems    ArchiveBatchItem[]
}

model CaseDocument {
  id         String   @id @default(uuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  type       String // e.g. "complaint", "evidence", "rebuttal"
  uploadedAt DateTime @default(now())

  // External Storage (OneDrive / SharePoint via Microsoft Graph)
  storageProvider  String? // e.g. "microsoft_graph"
  driveId          String?
  driveItemId      String?
  webUrl           String?
  fileName         String?
  mimeType         String?
  fileSize         Int?
  documentCategory String?
  sourceStatus     String?
  uploadedByUserId String?
  syncedAt         DateTime?
  syncStatus       String?
  syncError        String?

  documentChunks DocumentChunk[]
}

model CaseEvent {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action    String
  actorName String
  timestamp DateTime @default(now())
}

model DecisionDraft {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title     String
  status    String // "draft", "review", "approved"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections DecisionDraftSection[]
}

model DecisionDraftSection {
  id          String        @id @default(uuid())
  draftId     String
  draft       DecisionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  sectionType String // "facts", "issues", "reasoning", "conclusion"
  content     String        @db.Text
  order       Int
  status      String // "pending", "in_progress", "completed"
  updatedAt   DateTime      @updatedAt
}

model LegalSource {
  id              String    @id @default(uuid())
  title           String
  documentType    String // "SupremeAdministrativeCourt", "GPC_Decision", "Act"
  referenceNumber String?
  date            DateTime?
  url             String?

  year             Int?
  caseType         String?
  legalCategory    String?
  issueTags        String[]
  lawNames         String[]
  sectionNumbers   String[]
  decisionResult   String?
  sourceStatus     String    @default("ใช้งาน")
  reliabilityLevel String    @default("official")
  effectiveDate    DateTime?
  expiredDate      DateTime?
  sourceFileUrl    String?

  clauses        LegalClause[]
  ingestionJobs  DocumentIngestionJob[]
  documentChunks DocumentChunk[]
}

model LegalClause {
  id           String      @id @default(uuid())
  sourceId     String
  source       LegalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  clauseNumber String
  content      String      @db.Text
}

model AiQueryLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  prompt     String   @db.Text
  response   String   @db.Text
  tokensUsed Int?
  modelUsed  String?
  timestamp  DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  beforeValue String?  @db.Text
  afterValue  String?  @db.Text
  timestamp   DateTime @default(now())
}

model DocumentIngestionJob {
  id            String       @id @default(uuid())
  legalSourceId String?
  legalSource   LegalSource? @relation(fields: [legalSourceId], references: [id], onDelete: Cascade)
  status        String // "pending", "processing", "completed", "failed"
  errorMessage  String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model DocumentChunk {
  id             String        @id @default(uuid())
  legalSourceId  String
  legalSource    LegalSource   @relation(fields: [legalSourceId], references: [id], onDelete: Cascade)
  caseDocumentId String?
  caseDocument   CaseDocument? @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade)

  chunkIndex        Int
  title             String?
  content           String  @db.Text
  normalizedContent String  @db.Text

  pageNumber      Int?
  sectionName     String?
  paragraphNumber Int?

  sourceType       String
  sourceStatus     String
  reliabilityLevel String
  legalCategory    String?

  issueTags      String[]
  lawNames       String[]
  articleNumbers String[]
  decisionResult String?

  effectiveDate DateTime?
  expiredDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  embeddingModel  String?
  embeddedAt      DateTime?
  embeddingStatus String? // "pending", "completed", "failed"
  embeddingError  String?   @db.Text

  // embedding vector(1536) if using text-embedding-3-small
  // text-embedding-3-large would require vector(3072)
  embedding Unsupported("vector(1536)")?

  citations            DocumentChunkCitation[]
  retrievalResults     RetrievalResult[]
  legalAnswerCitations LegalAnswerCitation[]

  @@index([legalSourceId])
  @@index([sourceStatus])
  @@index([reliabilityLevel])
  @@index([legalCategory])
  @@index([issueTags])
  @@index([effectiveDate, expiredDate])
}

model DocumentChunkCitation {
  id        String        @id @default(uuid())
  chunkId   String
  chunk     DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model RetrievalQuery {
  id        String   @id @default(uuid())
  queryText String   @db.Text
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  results RetrievalResult[]
  answers LegalAnswer[]
}

model RetrievalResult {
  id        String         @id @default(uuid())
  queryId   String
  query     RetrievalQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  chunkId   String
  chunk     DocumentChunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  score     Float?
  rank      Int?
  createdAt DateTime       @default(now())
}

model LegalAnswer {
  id         String         @id @default(uuid())
  queryId    String
  query      RetrievalQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  answerText String         @db.Text
  modelUsed  String?
  createdAt  DateTime       @default(now())

  citations LegalAnswerCitation[]
}

model LegalAnswerCitation {
  id        String        @id @default(uuid())
  answerId  String
  answer    LegalAnswer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  chunkId   String
  chunk     DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model DraftSectionAiLog {
  id              String   @id @default(uuid())
  caseId          String
  draftId         String
  sectionId       String
  sectionType     String
  userInstruction String   @db.Text
  prompt          String   @db.Text
  generatedText   String   @db.Text
  modelUsed       String
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  timestamp       DateTime @default(now())

  chunkIds String[] // Array of retrieved DocumentChunk IDs used
}

model Meeting {
  id              String   @id @default(uuid())
  title           String
  meetingNo       String
  meetingDate     DateTime
  startTime       String?
  endTime         String?
  location        String?
  meetingType     String?
  status          String   @default("DRAFT") // "DRAFT", "SCHEDULED", "AGENDA_LOCKED", "IN_PROGRESS", "COMPLETED", "CANCELLED"
  chairName       String?
  secretaryName   String?
  notes           String?  @db.Text
  createdByUserId String?
  createdByUser   User?    @relation("MeetingCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agendaItems MeetingAgendaItem[]
  attendees   MeetingAttendee[]
}

model MeetingAgendaItem {
  id                     String    @id @default(uuid())
  meetingId              String
  meeting                Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  caseId                 String
  case                   Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  agendaNo               Int
  agendaType             String?
  proposedAction         String?
  readinessStatus        String    @default("PENDING_REVIEW") // "PENDING_REVIEW", "READY", "NEEDS_REVISION"
  reviewStatus           String?   @db.Text // JSON string or text summary of checklist
  boardResult            String? // "เห็นชอบตามร่าง", "ให้แก้ไขร่าง", "เลื่อนพิจารณา"
  boardNote              String?   @db.Text
  postMeetingAction      String?
  assignedFollowUpUserId String?
  assignedFollowUpUser   User?     @relation("FollowUpUser", fields: [assignedFollowUpUserId], references: [id])
  followUpDueDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingAttendee {
  id               String   @id @default(uuid())
  meetingId        String
  meeting          Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId           String?
  attendeeName     String
  role             String?
  attendanceStatus String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Records Retention, Archiving, and Knowledge Reuse models
model CaseArchiveRecord {
  id                     String   @id @default(uuid())
  caseId                 String   @unique
  case                   Case     @relation(fields: [caseId], references: [id])
  lifecycleStatus        String   // e.g., READY_TO_ARCHIVE, ARCHIVED
  archiveStatus          String   // e.g., PENDING, COMPLETED
  archiveReason          String?
  archiveBoxNo           String?
  archiveLocation        String?
  digitalArchiveFolderUrl String?
  finalRecordPackageDocumentId String?
  archivedAt             DateTime?
  archivedByUserId       String?
  unarchivedAt           DateTime?
  unarchivedByUserId     String?
  retentionPolicyId      String?
  retentionReviewDate    DateTime?
  legalHold              Boolean  @default(false)
  legalHoldReason        String?
  note                   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Added for Prompt 55: Retention and Batching
  previousStatusBeforeArchive String?
  archiveBatchId              String?
  archiveBatch                ArchiveBatch? @relation(fields: [archiveBatchId], references: [id])
  retentionStatus             String?
  retentionDueAt              DateTime?
  retentionReviewedAt         DateTime?
  retentionReviewedByUserId   String?
  retentionReviewNotes        String?       @db.Text
  legalHoldSetAt              DateTime?
  legalHoldSetByUserId        String?

  @@index([archiveStatus])
  @@index([retentionStatus])
  @@index([retentionDueAt])
  @@index([legalHold])
  @@index([archivedAt])
  @@index([archiveBatchId])
}

model RetentionPolicy {
  id                    String   @id @default(uuid())
  name                  String
  description           String?
  caseType              String?
  retentionPeriodYears  Int?
  reviewFrequencyMonths Int?
  isActive              Boolean  @default(true)
  requiresManualReview  Boolean @default(true)
  createdByUserId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model KnowledgeReuseReview {
  id                         String   @id @default(uuid())
  caseId                     String
  case                       Case     @relation(fields: [caseId], references: [id])
  finalDecisionDocumentId    String?
  knowledgeReuseStatus       String   // enum values defined in code
  status                     String   @default("PENDING") // workflow status: PENDING, APPROVED, REJECTED
  purpose                    String?  @db.Text
  reviewNote                 String?
  confidentialityLevel       String   @default("INTERNAL") // INTERNAL, CONFIDENTIAL, RESTRICTED
  containsPersonalData       Boolean  @default(true)
  requiresRedaction          Boolean  @default(true)
  redactionCompleted         Boolean  @default(false)
  approvedForInternalSearchAt DateTime?
  approvedForRagAt            DateTime?
  approvedAt                  DateTime?
  approvedByUserId           String?
  rejectedByUserId           String?
  rejectedAt                 DateTime?
  rejectionReason            String?
  requestedByUserId          String?
  revokedAt                  DateTime?
  revokedByUserId            String?
  revokeReason               String?
  ingestionJobId             String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

enum RecordLifecycleStatus {
  ACTIVE
  FINALIZED
  DISPATCHED
  COURT_FOLLOWUP
  READY_TO_ARCHIVE
  ARCHIVED
  RETENTION_REVIEW_REQUIRED
  HOLD
  REOPENED
}

enum KnowledgeReuseStatus {
  NOT_REVIEWED
  NOT_ELIGIBLE
  PENDING_REVIEW
  APPROVED_FOR_INTERNAL_SEARCH
  APPROVED_FOR_RAG
  INGESTED_TO_RAG
  REVOKED
  NEEDS_REDACTION
  HOLD
}

model ArchiveBatch {
  id                 String             @id @default(uuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdByUserId    String?
  createdByUser      User?              @relation("ArchiveBatchCreator", fields: [createdByUserId], references: [id])
  dryRun             Boolean            @default(false)
  status             String             // "DRAFT", "DRY_RUN", "READY", "EXECUTED", "PARTIAL", "FAILED", "CANCELLED"
  reason             String?
  policyReference    String?
  confirmationMarker String?            // Hash or marker, not raw confirmation text
  totalCount         Int                @default(0)
  eligibleCount      Int                @default(0)
  blockedCount       Int                @default(0)
  executedAt         DateTime?
  notes              String?            @db.Text

  items              ArchiveBatchItem[]
  archiveRecords     CaseArchiveRecord[]
}

model ArchiveBatchItem {
  id                    String       @id @default(uuid())
  archiveBatchId        String
  archiveBatch          ArchiveBatch @relation(fields: [archiveBatchId], references: [id], onDelete: Cascade)
  caseId                String
  case                  Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt             DateTime     @default(now())
  status                String       // "ELIGIBLE", "BLOCKED", "EXECUTED", "FAILED", "SKIPPED"
  previousCaseStatus    String?
  previousArchiveStatus String?
  blockedReasons        String?      @db.Text // serialized JSON or text
  impactPreview         String?      @db.Text // serialized JSON or text
  executedAt            DateTime?
  resultMessage         String?      @db.Text

  @@index([archiveBatchId])
}
 

enum ExternalProvider {
  MICROSOFT_GRAPH
}

enum ExternalSourceType {
  SHAREPOINT_SITE
  ONEDRIVE_FOLDER
}

enum ExternalDocumentSyncStatus {
  PENDING
  SYNCED
  FAILED
  IGNORED
}

enum DocumentSyncRunStatus {
  STARTED
  COMPLETED
  FAILED
  PARTIAL
}

enum DocumentSyncRunMode {
  MANUAL
  SCHEDULED
}

model ExternalDocumentSource {
  id               String   @id @default(uuid())
  provider         ExternalProvider
  sourceType       ExternalSourceType
  displayName      String?
  safeDescription  String?
  
  siteIdHash       String?
  driveIdHash      String?
  folderItemIdHash String?
  rawIdsStored     Boolean  @default(false)
  
  enabled          Boolean  @default(true)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String?
  lastCheckedAt    DateTime?

  items            ExternalDocumentItem[]
  syncRuns         DocumentSyncRun[]
}

model ExternalDocumentItem {
  id                  String   @id @default(uuid())
  sourceId            String
  source              ExternalDocumentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  
  provider            ExternalProvider
  sourceType          ExternalSourceType
  
  externalItemKeyHash String
  externalETagHash    String?
  
  safeDisplayName     String
  itemKind            String?
  extension           String?
  mimeType            String?
  sizeBytes           BigInt?
  
  createdAtExternal   DateTime?
  lastModifiedAtExternal DateTime?
  
  hasWebUrl           Boolean  @default(false)
  webUrlStored        Boolean  @default(false)
  
  syncStatus          ExternalDocumentSyncStatus @default(PENDING)
  lastSeenAt          DateTime @default(now())
  lastSyncedAt        DateTime?
  
  linkedDocumentId    String?
  linkedCaseId        String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([provider])
  @@index([sourceId])
  @@index([externalItemKeyHash])
  @@index([syncStatus])
  @@index([lastSeenAt])
}

model DocumentSyncRun {
  id                 String   @id @default(uuid())
  sourceId           String?
  source             ExternalDocumentSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  
  provider           ExternalProvider
  mode               DocumentSyncRunMode @default(MANUAL)
  
  dryRun             Boolean  @default(true)
  metadataOnly       Boolean  @default(true)
  contentDownloaded  Boolean  @default(false)
  dbMutated          Boolean  @default(false)
  ragIndexed         Boolean  @default(false)
  
  status             DocumentSyncRunStatus @default(STARTED)
  
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  startedById        String?
  
  totalSeen          Int      @default(0)
  wouldSyncCount     Int      @default(0)
  wouldSkipCount     Int      @default(0)
  persistedItemCount Int      @default(0)
  warningCount       Int      @default(0)
  
  errorCode          String?
  errorSummary       String?

  items              DocumentSyncRunItem[]

  @@index([provider])
  @@index([status])
}

model DocumentSyncRunItem {
  id                  String   @id @default(uuid())
  runId               String
  run                 DocumentSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  
  externalItemKeyHash String
  safeDisplayName     String
  itemKind            String?
  extension           String?
  mimeType            String?
  sizeBytes           BigInt?
  
  status              ExternalDocumentSyncStatus @default(PENDING)
  wouldSync           Boolean  @default(false)
  wouldSkip           Boolean  @default(false)
  skipReasons         String?
  
  contentDownloaded   Boolean  @default(false)
  documentCreated     Boolean  @default(false)
  ragIndexed          Boolean  @default(false)
  
  createdAt           DateTime @default(now())

  @@index([runId])
  @@index([externalItemKeyHash])
}

model GraphContentIngestionQuarantineItem {
  id                  String   @id @default(uuid())
  prototypeRunId      String?
  externalItemKeyHash String
  safeDisplayName     String
  extension           String?
  mimeType            String?
  sizeBytes           BigInt?
  classification      String?
  quarantineReason    String
  quarantineStatus    String   @default("QUARANTINED")
  reviewNotes         String?  @db.Text
  reviewedById        String?
  reviewedAt          DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([prototypeRunId])
  @@index([externalItemKeyHash])
  @@index([quarantineStatus])
}
