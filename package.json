{
  "name": "temp_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "styles:tabler": "node scripts/build-tabler-css.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/lib/dashboard/*.test.ts src/lib/analysis/*.test.ts src/lib/thai-law/*.test.ts",
    "db:seed": "prisma db seed",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:dashboard": "tsx --test src/lib/dashboard/*.test.ts",
    "test:case-list": "tsx --test src/lib/caseList.test.ts",
    "seed:archive-pilot:dry-run": "tsx scripts/seed-archive-pilot-records.ts --dry-run",
    "seed:archive-pilot:execute": "tsx scripts/seed-archive-pilot-records.ts --execute"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tabler/core": "1.6.1",
    "@tabler/icons-react": "3.35.0",
    "@types/pg": "^8.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "docxtemplater": "^3.68.7",
    "lucide-react": "^1.17.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "openai": "^6.42.0",
    "pg": "^8.22.0",
    "pizzip": "^3.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss-prefix-selector": "2.2.1",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.7.1",
    "typescript": "^5"
  },
  "prisma": {
